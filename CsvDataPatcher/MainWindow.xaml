<Window x:Class="CsvDataPatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CsvDataPatcher"
        mc:Ignorable="d"
        Title="CSV Appender Tool"
         Icon="/icon.png"
        Height="550"
        Width="800"
        MinHeight="450"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="CSV APPENDER TOOL"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <!-- File path label -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="CSV File Path:"
                   VerticalAlignment="Center"
                   Margin="0,0,0,5" />

        <!-- File path input + browse button -->
        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   LastChildFill="True"
                   Margin="0,0,0,15">
            <Button x:Name="BrowseButton"
                    DockPanel.Dock="Right"
                    Content="Browse..."
                    Width="100"
                    Height="30"
                    Click="BrowseButton_Click"
                    Margin="10,0,0,0" />
            <TextBox x:Name="FilePathTextBox"
                     VerticalAlignment="Center"
                     DockPanel.Dock="Left" />
        </DockPanel>

        <!-- Data input label -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                   Text="Data to Append (separate each column with a comma):"
                   Margin="0,10,0,5" />

        <!-- Data input textbox (this is the only expanding row) -->
        <TextBox x:Name="DataTextBox"
                 Grid.Row="4" Grid.ColumnSpan="2"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 MinHeight="200"
                 Margin="0,0,0,15" />

        <!-- Append button -->
        <Button x:Name="AppendButton"
                Grid.Row="5" Grid.ColumnSpan="2"
                Content="Append Data"
                Width="140"
                Height="40"
                HorizontalAlignment="Center"
                Click="AppendButton_Click"
                Margin="0,10,0,0" />

        <!-- Status message -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="6" Grid.ColumnSpan="2"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"
                   Foreground="Green"
                   FontWeight="Bold" />
    </Grid>
</Window>